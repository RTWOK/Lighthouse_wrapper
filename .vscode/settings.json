{
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.linkedEditing": true,
    "html.autoClosingTags": true,
    "files.associations": {
        "*.njk": "nunjucks"
    },
    "auto-close-tag.activationOnLanguage": [
        "html",
        "nunjucks"
    ],
    "auto-rename-tag.activationOnLanguage": [
        "html",
        "nunjucks"
    ]
}
